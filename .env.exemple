# Copier en .env puis adapter. Toutes les valeurs ont un défaut dans src/demandes/config.py.

# --- Base de données (docker compose expose Postgres sur 5433) ---
DATABASE_URL=postgresql://demandes:demandes@localhost:5433/demandes

# --- Mapping des colonnes de l'export Excel vers les noms internes ---
COLONNE_NUMERO=numero
COLONNE_TITRE=titre
COLONNE_MAIL=description
# Laisser vide si l'export n'a pas de date (le contrôle dans le temps est alors désactivé).
COLONNE_DATE=date
# Feuille à lire (vide = la première).
FEUILLE_EXCEL=

# --- IAG (API compatible OpenAI) ---
IAG_BASE_URL=http://localhost:8080/v1
IAG_API_KEY=inutile
IAG_MODELE=modele-interne
IAG_TEMPERATURE=0
IAG_TIMEOUT_S=120
# json_schema (décodage guidé, défaut) ou json_object (repli : le schéma est décrit dans le prompt)
JSON_MODE=json_schema
PROMPT_FICHE=prompts/fiche_v1.md
# Fiches par lots (ADR-0010) : nombre de mails par appel (1 = un mail par appel)
FICHES_PAR_APPEL=10
# Budget de caractères de mails par appel, pour ne pas dépasser le contexte
LOT_MAX_CARACTERES=40000
# Un mail plus long est tronqué avant envoi (entre dans l'empreinte de la fiche)
MAIL_MAX_CARACTERES=8000
# Budget de tokens de sortie par fiche (max_tokens = ce budget x nombre de fiches)
IAG_MAX_TOKENS_PAR_FICHE=400
# charger enchaîne sur les fiches et embeddings manquants (désactivable : charger --sans-fiches)
FICHES_A_L_INGESTION=true

# --- Embedding (API compatible OpenAI) ---
EMB_BASE_URL=http://localhost:8081/v1
EMB_API_KEY=inutile
EMB_MODELE=bge-m3
EMB_DIMENSION=1024
# Textes par appel d'embedding
EMBED_PAR_APPEL=100

# Simule la fiche et l'embedding (aucun appel réseau).
MOCK_LLM=false

# --- Apprentissage et évaluation ---
SEED=42
MIN_PAR_TITRE=10
TAILLE_TEST=0.2
N_PLIS=5
LLM_CONCURRENCY=4
# Nombre de processus pour le calcul (-1 = tous les cœurs).
N_JOBS=-1

# --- Mode de décision ---
# MODE : seul | moyenne | meta
MODE=seul
# Liste séparée par des virgules : svm_tfidf, rl_tfidf, svm_emb, rl_emb, knn_emb
MODELES=svm_tfidf

# --- Seuils de confiance (réglés ensuite d'après la courbe couverture / précision) ---
SEUIL_HAUT=0.80
SEUIL_MOYEN=0.40

# --- Repérage des templates ---
# Une ligne fixe doit revenir à l'identique dans au moins N mails...
TEMPLATE_MIN_MAILS=5
# ... et dans au plus cette part du corpus (au-delà, c'est une formule banale du type « Bonjour »).
TEMPLATE_FREQ_MAX=0.30
# Nombre de lignes fixes distinctes pour qu'un mail soit considéré comme issu d'un template.
TEMPLATE_MIN_MARQUEURS=2
# Un objet de mail identique dans au moins TEMPLATE_MIN_MAILS mails compte aussi comme template.
TEMPLATE_OBJET=true
# Motifs (expressions régulières) qui désignent d'office un template, séparés par « ;; »
TEMPLATE_MOTIFS=

# --- Divers ---
DOSSIER_ARTEFACTS=artefacts
NIVEAU_LOG=INFO
